# Optional overrides — bvoip-mcp has no required env vars.
# Authentication is per-request via the X-Bvoip-Api-Key request header
# (a static 1Stream API key, created in the 1Stream portal — see
# "Creating API Keys in 1Stream" at https://docs.1stream.com).
# This server forwards it verbatim (no "Bearer " prefix) as the
# Authorization header on every call, matching 1Stream's own convention.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Fixed 1Stream ClientAccess base URL — override only if your organization
# is provisioned on a different 1Stream portal host.
# BVOIP_BASE_URL=https://portal.1stream.com/api/ClientAccess.svc
